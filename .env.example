# Скопируй этот файл в .env и заполни своими значениями (.env не коммитится!)

# Длинная случайная строка — ключ для подписи сессий
SECRET_KEY=change-me-to-a-long-random-string

# Подключение к MySQL
DB_HOST=your-db-host
DB_PORT=3306
DB_NAME=your-db-name
DB_USER=your-db-user
DB_PASSWORD=your-db-password

# Настройки сервера
HOST=127.0.0.1
PORT=5000
# 1 — включить режим отладки (только для локальной разработки!)
FLASK_DEBUG=0
